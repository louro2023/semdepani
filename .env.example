# Copie para .env e preencha antes de iniciar em producao

# OBRIGATORIO em producao — segredo para assinar tokens JWT
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# Admin inicial (criado no primeiro start)
ADMIN_CPF=seu-cpf-sem-pontos
ADMIN_PASSWORD=senha-forte-aqui

# Opcional
PORT=4000
LISTEN_HOST=127.0.0.1
DB_PATH=data/castracao.sqlite
