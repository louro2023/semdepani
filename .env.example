# Copie para .env e preencha antes de iniciar

# OBRIGATORIO — segredo para assinar tokens JWT
# Em dev use qualquer string; em producao use string aleatoria longa
JWT_SECRET=dev-secret-local

# Admin inicial (criado no primeiro start)
# Em dev pode usar os valores abaixo; em producao use CPF e senha reais
ADMIN_CPF=00000000000
ADMIN_PASSWORD=admin123

# Opcional
PORT=4000
LISTEN_HOST=127.0.0.1
DB_PATH=data/castracao.sqlite

# E-mail (opcional — sem SMTP_HOST o envio fica desativado)
SMTP_HOST=smtplw.com.br
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
SMTP_FROM=noreply@seudominio.com.br
